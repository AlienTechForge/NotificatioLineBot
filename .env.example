# ─────────────────────────────────────────────────
#  複製成 .env 後填入實際值。.env 不會進版控。
#  正式環境的 .env 應由 root 擁有並設 chmod 600。
# ─────────────────────────────────────────────────

# ── LINE Messaging API ────────────────────────────
# LINE Developers Console → Messaging API channel
# 注意：dev 環境請用另一個「測試用」Official Account，
#      否則測試訊息會直接發到真實使用者手機上。
LINE_CHANNEL_TOKEN=
LINE_CHANNEL_SECRET=

# ── 應用 ──────────────────────────────────────────
# client secret 的加密金鑰。32 bytes 的 base64。
# 產生：openssl rand -base64 32
#
# 遺失這把 key = 所有 client secret 無法解密，只能全體重發金鑰。
# 必須與資料庫備份「分開」存放，並保留至少兩份。
APP_SECRET_ENC_KEY=

# 以下兩項只在「金鑰輪替期間」才需要，平時留空。
# 輪替程序見 Docs/plan/09-CICD與維運.md 7.1：
#   1. 產生新 key 填入 _V2
#   2. 重啟（此時能用 v1 解密、v2 加密）
#   3. 把 VERSION 改成 2 並重啟
#   4. 跑重加密任務，確認沒有 secret_key_version=1 的資料
#   5. 清空 _V2 並把新 key 移到 APP_SECRET_ENC_KEY，VERSION 改回 1
APP_SECRET_ENC_KEY_VERSION=1
APP_SECRET_ENC_KEY_V2=

# 產生 enrollment 一次性連結用。必須是 https。
APP_PUBLIC_BASE_URL=https://notify.example.com

# 初始管理者的 LINE User ID（啟動時 upsert is_owner=true）
# 取得方式：加 Bot 好友後傳「我的ID」
APP_OWNER_LINE_USER_ID=

# 訊息內容中允許出現的連結網域，逗號分隔。
#
# 這條規則適用於「所有」通知，不只 notify:raw —— LINE 客戶端會自動把純文字裡的
# https:// 變成可點連結，釣魚效果與 uri action 完全相同。
#
# 留空 = 不允許任何外部連結（安全的預設值）。
# 想在通知裡附連結（CI 失敗連到 build log、監控連到 dashboard）就必須先列在這裡，
# 否則會收到 400 URI_HOST_NOT_ALLOWED。子網域自動涵蓋：填 azndev.com 就同時允許
# grafana.azndev.com。
APP_ALLOWED_URI_HOSTS=

# ── 派送 ──────────────────────────────────────────
# 排程取件間隔。這是「最壞情況的延遲」—— 受理當下就會直接踢一次派送。
APP_DISPATCH_POLL_INTERVAL=PT10S
# 單輪取幾批
APP_DISPATCH_BATCH_LIMIT=10
# 我方主動限速（LINE multicast 上限 200 req/s，只用一半，留給 webhook 回覆）
LINE_RATE_LIMIT_PER_SECOND=100

# ── 資料庫 ────────────────────────────────────────
DB_URL=jdbc:postgresql://postgres:5432/notifyline
DB_USER=notifyline
DB_PASSWORD=

# ── 部署 ──────────────────────────────────────────
# 主機上要對應的 port。只綁 127.0.0.1，由同機的 nginx 反向代理對外。
# 8080 常被占用，預設用比較冷門的 19080。
# 換 port 前先確認沒被占用：  ss -ltnp | grep :19080
APP_PORT=19080

# ── Spring ────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
